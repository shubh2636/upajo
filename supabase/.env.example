# ==============================================================================
# Upajo (उपजो) - Supabase Edge Functions Server Secrets Template
# ==============================================================================
# These secrets are set in Supabase Vault / Edge Functions via:
# `supabase secrets set --env-file supabase/.env.production`
# NEVER bundle this file in the mobile app or commit production values to git.
# ==============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Backend Secrets (Server-side HMAC-SHA256 signature verification)
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Firebase Cloud Messaging Server Key (Push Notifications)
FCM_SERVER_KEY=your_fcm_server_key_here

# Microservice Mutual Auth & URL
ML_SERVICE_URL=https://upajo-ml-service.onrender.com
ML_SERVICE_API_KEY=your_secure_random_ml_service_api_key_here

