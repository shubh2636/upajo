# ==============================================================================
# Upajo (उपजो) - Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME=Upajo
APP_NAME_HI=उपजो
APP_PACKAGE_ID=com.upajo.app
APP_ENV=development

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway (Test Mode for development)
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Farming Assistant (Krishi Sahayak - Claude 3.5 Sonnet)
# Stored securely on backend / Supabase Edge Functions / FastAPI proxy
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXX

# Open-Meteo Weather API (Free, no API key needed for basic tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Python FastAPI ML Microservice (Crop disease detection & advisory backend)
ML_SERVICE_URL=http://10.0.2.2:8000
ML_SERVICE_API_KEY=upajo_internal_ml_secret_key

# Fast2SMS OTP Gateway (Optional fallback for SMS OTP)
FAST2SMS_API_KEY=your_fast2sms_auth_key

