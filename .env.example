# ==============================================================================
# Upajo (उपजो) - Client Application Environment Template
# ==============================================================================
# SECURITY POLICY: ONLY public client keys are permitted in this file.
# NEVER place backend service role keys, API secrets, or private keys here.
# All payment secrets, AI tokens, and database service keys must remain server-side.
# ==============================================================================

# Application Meta
APP_NAME=Upajo
APP_NAME_HI=उपजो
APP_PACKAGE_ID=com.upajo.app
APP_ENV=development

# Supabase Public Client Configuration
# (Obtain from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Public Merchant Key ID (Client-side checkout invocation)
# (Obtain from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder

# Python FastAPI ML Microservice URL (Local Emulator or Cloud Gateway)
ML_SERVICE_URL=http://10.0.2.2:8000

# Open-Meteo Weather API (Free agricultural forecast tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
