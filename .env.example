# ==============================================================================
# Upajo (उपजो) - Client Application Environment Template
# ==============================================================================
# Copy this file to '.env' (which is gitignored) OR pass via compile-time
# --dart-define flags when executing 'flutter run'.
#
# CRITICAL SECURITY POLICY:
# - ONLY public client keys are permitted here.
# - NEVER put backend service_role keys, JWT secrets, or DB passwords here.
# - The client app will fail loudly at startup if service_role is detected.
# ==============================================================================

# Application Metadata
APP_NAME=Upajo
APP_NAME_HI=उपजो
APP_PACKAGE_ID=in.upajo.app
APP_ENV=development

# 1. Supabase Public Client Configuration
# (Obtain from your Supabase Dashboard -> Project Settings -> API)
# Must start with https:// and must NOT contain "your-project" or "placeholder"
SUPABASE_URL=https://sskbabrsrbgjemsofiam.supabase.co
# Must be your public "anon" / "publishable" key (NEVER service_role)
SUPABASE_ANON_KEY= 'sb_publishable_fGh_wsAUJv-wBPzastWBNQ_xu-ji3vY'

# 2. FastAPI ML Microservice Base URL
# - Android Emulator: http://10.0.2.2:8000
# - Physical Android Phone (same WiFi): http://<YOUR-PC-LOCAL-IP>:8000 (e.g. http://192.168.1.5:8000)
# - Web / Windows Desktop: http://127.0.0.1:8000
# - Production Gateway: https://api.upajo.in
API_BASE_URL=http://10.0.2.2:8000
ML_SERVICE_URL=http://10.0.2.2:8000

# 3. Razorpay Public Merchant Key ID (Client-side checkout invocation)
# (Obtain from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_TyRiRRVqfUwGig

# 4. Open-Meteo Weather API (Agricultural forecast tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&hourly=temperature_2m,relative_humidity_2m,dew_point_2m,rain,visibility,vapour_pressure_deficit,soil_temperature_0cm,soil_temperature_6cm,soil_temperature_18cm,soil_moisture_0_to_1cm,soil_temperature_54cm&timezone=auto

# 5. Map Tile Provider (OpenStreetMap / MapTiler)
MAP_TILE_URL=https://api.maptiler.com/maps/streets-v4/?key=k6AUzDwsrzEqK11bQK2T#1.0/0.00000/0.00000
