# ==============================================================================
# Upajo (उपजो) - FastAPI ML Microservice Environment Template
# ==============================================================================
# Stored on Render / Railway backend dashboard secrets.
# NEVER commit production secrets or bundle with mobile APK.
# ==============================================================================

ENVIRONMENT=development
PORT=8000

# Backend Authentication Key between Edge Functions and ML Microservice
ML_SERVICE_API_KEY=your_secure_random_ml_service_api_key_here

# Google Gemini API Configuration (Krishi Sahayak Voice & Chat AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Commercial Weather Provider Gateway
WEATHER_API_KEY=your_commercial_weather_api_key_here
WEATHER_PROVIDER=open_meteo_cached

# Map Tile URL (MapTiler / Stadia / Geoapify)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Supabase Server Verification (JWT & DB Access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# CORS Allowed Origins (Comma-separated, no wildcard '*' allowed in production)
ALLOWED_ORIGINS=https://upajo.com,https://app.upajo.com,http://localhost:3000

# Agmarknet Mandi Rates API (Optional government data gateway key)
AGMARKNET_API_KEY=your_agmarknet_api_key_here
